# Agent scratch space: logs, dumps, one-off scripts, fetched pages.
.tmp/

# Tool scratch output. It belongs in .tmp/, and this is the belt.
.playwright-cli/

# Written by `openspec update`; the tool owns it.
.agents/skills/.openspec-target

# Local secrets and environment
.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db

# Logs
*.log

# .NET build output and tooling
bin/
obj/
# Publish output at the repository root. Unanchored, this pattern also matches
# wwwroot/lib/bootstrap/dist/, which would ship the app without any CSS.
/dist/
*.user
.vs/
*.suo
TestResults/
