<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- GitHub Pages cannot negotiate per-file precompressed assets, so publish
         ships plain files and lets the CDN compress at the edge. -->
    <EnableDefaultCompressionFormats>false</EnableDefaultCompressionFormats>
    <!-- No lock file here: the wasm-tools workload injects SDK packs whose
         content hash differs between the Windows and Linux installs, so a lock
         file written here fails NU1403 on the runner. The SDK pin in global.json
         and the pinned package versions above are this project's guard.
         shortcut: lock file off, turn it back on when the workload packs hash
         the same across operating systems. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlzChess.Core\BlzChess.Core.csproj" />
  </ItemGroup>

</Project>
