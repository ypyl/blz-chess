@page "/"
@using BlzChess.Core
@using BlzChess.Web.Engine
@inject IEngine Engine
@inject IJSRuntime JS

<PageTitle>BlzChess</PageTitle>

<main class="shell">
    <header class="bar">
        <select @key="_flow.Level?.Index"
                class="level-select"
                aria-label="Opponent level"
                value="@_flow.Level.Index"
                @onchange="OnLevelChanged">
            @foreach (var level in Level.All)
            {
                <option value="@level.Index">@level.Name</option>
            }
        </select>
        <div class="actions">
            @if (_flow.Stage == GameStage.Playing)
            {
                <button type="button"
                        class="ghost"
                        disabled="@(_flow.Session.Game.Moves.Count == 0)"
                        @onclick="UndoLastMove">
                    Undo
                </button>
            }
            <button type="button" class="ghost" @onclick="HeaderAction">@HeaderActionLabel</button>
        </div>
    </header>

    @* The computer's tray sits above the board, nearest the pieces it still has. Its
       line is reserved whether or not it holds a piece: the shell is centred
       vertically, so a row that appeared would push the board up. *@
    <div class="tray" aria-label="@TakenByComputer">
        @foreach (var piece in Taken(Color.White))
        {
            <img src="@PiecePath(piece)" alt="" aria-hidden="true" draggable="false" />
        }
    </div>

    <div class="board"
         role="grid"
         aria-label="Chess board"
         @ref="_board"
         @onpointermove="OnPointerMoveAsync"
         @onpointerup="OnPointerUpAsync"
         @onpointercancel="OnPointerCancelAsync">
        @for (var rank = 7; rank >= 0; rank--)
        {
            @for (var file = 0; file < 8; file++)
            {
                var square = Squares.Index(file, rank);
                <button type="button"
                        class="@SquareClass(square)"
                        aria-label="@SquareLabel(square)"
                        aria-pressed="@(_selected == square ? "true" : "false")"
                        @onpointerdown="args => OnPointerDown(args, square)"
                        @onclick="() => OnSquareAsync(square)">
                    @if (PieceAt(square) is { } piece)
                    {
                        @* Decorative: the button's label already names the square and
                           its piece, and a non-empty alt paints as text while the
                           SVG loads, which is the flash this change removes. *@
                        <img src="@PiecePath(piece)" alt="" aria-hidden="true" draggable="false" />
                    }
                </button>
            }
        }
        @* The piece in the air. Drawn inside the board for the same reason as the arrow,
           and invisible to pointers so it never swallows the event tracking it. *@
        @if (_dragging && _dragFrom != Squares.None && PieceAt(_dragFrom) is { } held)
        {
            <img class="drag-piece"
                 src="@PiecePath(held)"
                 alt=""
                 aria-hidden="true"
                 draggable="false"
                 style="@GhostStyle" />
        }
        @* Inside the board, not beside it: `inset: 0` resolves against the nearest
           positioned ancestor, and a sibling would have spanned the window. *@
        @if (_engineMove is { } move)
        {
            var (line, head) = ArrowGeometry(move);
            <svg class="engine-arrow" viewBox="0 0 800 800" preserveAspectRatio="none" aria-hidden="true">
                <line x1="@line.X1" y1="@line.Y1" x2="@line.X2" y2="@line.Y2" />
                <polygon points="@head" />
            </svg>
        }
    </div>

    @* The player's tray, below the board and nearest the player's own pieces. *@
    <div class="tray" aria-label="@TakenByPlayer">
        @foreach (var piece in Taken(Color.Black))
        {
            <img src="@PiecePath(piece)" alt="" aria-hidden="true" draggable="false" />
        }
    </div>

    <p class="status @(_flow.Stage == GameStage.Finished ? "over" : null)" title="@Status" aria-live="polite">@Status</p>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
</main>

@code {
    private GameFlow _flow = default!;
    private int _selected = Squares.None;
    private HashSet<int> _targets = [];
    private bool _thinking;
    private Move? _engineMove;
    private string? _error;

    private ElementReference _board;
    private double _boardLeft;
    private double _boardTop;
    private double _boardSide;

    // A press is not a drag until the pointer travels this far, so a tap keeps being a
    // tap and its click still moves a piece the way it always did.
    private const double DragThreshold = 6;

    private int _dragFrom = Squares.None;
    private long _dragPointerId;
    private double _dragOriginX;
    private double _dragOriginY;
    private double _dragX;
    private double _dragY;
    private bool _dragging;
    private bool _captured;

    protected override void OnInitialized() => _flow = new GameFlow(Engine);

    private string HeaderActionLabel => _flow.Stage == GameStage.Finished ? "New game" : "Restart";

    private string Status => _flow.Result.IsOver
        ? _flow.Result.Describe(Color.White)
        : _thinking ? "Thinking…" : "Your move.";

    /// <summary>
    /// Changes the opponent without touching the game. Mid-game it applies to the next
    /// move; after a result it applies to the next game.
    /// </summary>
    private void OnLevelChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var index) && _flow.ChangeLevel(Level.ByIndex(index)))
        {
            _error = null;
        }
    }

    private void UndoLastMove()
    {
        if (_flow.UndoLastMove())
        {
            ClearSelection();
            // The move the arrow described is gone with the take-back.
            _engineMove = null;
        }
    }

    private void HeaderAction()
    {
        if (_flow.Stage == GameStage.Finished)
        {
            NewGame();
            return;
        }

        if (_flow.Restart())
        {
            ClearSelection();
            _engineMove = null;
            _thinking = false;
            _error = null;
        }
    }

    private void NewGame()
    {
        _flow.NewGame();
        ClearSelection();
        _engineMove = null;
        _thinking = false;
        _error = null;
    }

    private void ClearSelection()
    {
        _selected = Squares.None;
        _targets = [];
    }

    private Piece? PieceAt(int square) => _flow.Session?.Game.Position[square];

    /// <summary>
    /// The pieces of <paramref name="color"/> that are off the board, in the order of
    /// value, so the same row means the same thing game after game.
    /// </summary>
    private IEnumerable<Piece> Taken(Color color) =>
        _flow.Session is { } session
            ? session.Game.Captured.Where(piece => piece.Color == color).OrderBy(piece => (int)piece.Type)
            : [];

    private string TakenByComputer => DescribeTray(Color.White, "The computer has taken");

    private string TakenByPlayer => DescribeTray(Color.Black, "You have taken");

    private string DescribeTray(Color color, string lead) =>
        Taken(color) is { } pieces && pieces.Any()
            ? lead + ": " + string.Join(", ", pieces.Select(piece => PieceAlt(piece)))
            : lead + ": nothing yet";

    private string SquareClass(int square)
    {
        var classes = new List<string> { "square", Squares.IsLight(square) ? "light" : "dark" };
        if (_selected == square)
        {
            classes.Add("selected");
        }

        if (_targets.Contains(square))
        {
            classes.Add("target");
        }

        if (_dragging && _dragFrom == square)
        {
            classes.Add("lifted");
        }

        if (_thinking || _flow.Stage != GameStage.Playing)
        {
            classes.Add("locked");
        }

        return string.Join(' ', classes);
    }

    private string SquareLabel(int square)
    {
        var name = Squares.Name(square);
        return PieceAt(square) is { } piece ? $"{name}, {PieceAlt(piece)}" : $"{name}, empty";
    }

    private async Task OnSquareAsync(int square)
    {
        if (_flow.Session is not { } session || _flow.Stage != GameStage.Playing || _thinking)
        {
            return;
        }

        if (_selected != Squares.None && _targets.Contains(square))
        {
            if (await PlayAsync(_selected, square))
            {
                return;
            }
        }

        var legalFromSquare = PieceAt(square) is { } clicked
            && clicked.Color == session.PlayerColor
                ? session.LegalMovesFrom(square)
                : [];

        if (legalFromSquare.Count == 0)
        {
            ClearSelection();
            return;
        }

        _selected = square;
        _targets = [.. legalFromSquare.Select(move => move.To)];
    }

    /// <summary>
    /// Plays a move the player has chosen, by click or by drop, and lets the computer
    /// answer. False when the rules refuse it, in which case nothing moved.
    /// </summary>
    private async Task<bool> PlayAsync(int from, int to)
    {
        var move = new Move(from, to, PromotionIfAny(from, to));
        if (!_flow.TryPlayerMove(move, out _))
        {
            return false;
        }

        ClearSelection();
        _engineMove = null;
        await EngineReplyAsync();
        return true;
    }

    private string GhostStyle =>
        FormattableString.Invariant(
            $"left:{_dragX - (_boardSide / 16):0.##}px;top:{_dragY - (_boardSide / 16):0.##}px;width:{_boardSide / 8:0.##}px;height:{_boardSide / 8:0.##}px");

    /// <summary>
    /// A press on one of the player's pieces takes hold of it. Nothing is awaited here: a
    /// round trip to the browser before the drag is armed loses a fast flick, and the
    /// square is already known because the press happened on that square's own button.
    /// The selection is left to the click, so a press that never travels stays a tap.
    /// </summary>
    private void OnPointerDown(PointerEventArgs args, int square)
    {
        if (_flow.Session is not { } session || _flow.Stage != GameStage.Playing || _thinking)
        {
            return;
        }

        if (Drag.Lift(session, square) == Squares.None)
        {
            return;
        }

        _dragFrom = square;
        _dragPointerId = args.PointerId;
        _dragOriginX = args.ClientX;
        _dragOriginY = args.ClientY;
        _dragging = false;
    }

    /// <summary>
    /// The piece is in the air once the pointer has gone far enough to mean it. Its legal
    /// destinations appear the way a click shows them.
    /// </summary>
    private async Task OnPointerMoveAsync(PointerEventArgs args)
    {
        if (_dragFrom == Squares.None || args.PointerId != _dragPointerId)
        {
            return;
        }

        if (!_dragging)
        {
            var dx = args.ClientX - _dragOriginX;
            var dy = args.ClientY - _dragOriginY;
            if (Math.Sqrt((dx * dx) + (dy * dy)) < DragThreshold)
            {
                return;
            }

            // Measured before the piece is lifted, so the piece is drawn at the board's
            // size on its first frame instead of at a stale one.
            await MeasureBoardAsync();

            // Capture now, not on the press: a captured pointer sends the click that
            // follows a tap to the board instead of the square, which would take
            // tap-to-move away. By here the press is a drag and there is no click to lose.
            await JS.InvokeVoidAsync("blzPointer.capture", _board, _dragPointerId);
            _captured = true;

            _dragging = true;
            Select(_dragFrom);
        }

        FollowPointer(args);
        StateHasChanged();
    }

    private async Task OnPointerUpAsync(PointerEventArgs args)
    {
        if (_dragFrom == Squares.None || args.PointerId != _dragPointerId)
        {
            return;
        }

        var from = _dragFrom;
        var wasDragging = _dragging;
        await EndDragAsync();

        if (!wasDragging)
        {
            // A press that did not travel. The click that follows still moves the piece.
            return;
        }

        // Measured again rather than trusted from the press: the window can be resized
        // between the two, and the drop is the one reading that has to be right.
        await MeasureBoardAsync();
        var landing = BoardGeometry.SquareAt(args.ClientX - _boardLeft, args.ClientY - _boardTop, _boardSide);
        var to = Drag.Land(_targets, landing);
        if (to == Squares.None)
        {
            // Let go where the piece may not go: it stays put, still selected, so the
            // player can tap a destination instead.
            return;
        }

        await PlayAsync(from, to);
    }

    private async Task OnPointerCancelAsync(PointerEventArgs args)
    {
        if (_dragFrom != Squares.None && args.PointerId == _dragPointerId)
        {
            await EndDragAsync();
        }
    }

    private async Task MeasureBoardAsync()
    {
        var box = await JS.InvokeAsync<BoardBox>("blzPointer.rect", _board);
        _boardLeft = box.Left;
        _boardTop = box.Top;
        _boardSide = box.Width;
    }

    private void FollowPointer(PointerEventArgs args)
    {
        _dragX = args.ClientX - _boardLeft;
        _dragY = args.ClientY - _boardTop;
    }

    private async Task EndDragAsync()
    {
        if (_captured)
        {
            await JS.InvokeVoidAsync("blzPointer.release", _board, _dragPointerId);
            _captured = false;
        }

        _dragFrom = Squares.None;
        _dragging = false;
        StateHasChanged();
    }

    /// <summary>Selects a piece and its destinations, the way a click does.</summary>
    private void Select(int square)
    {
        if (_flow.Session is not { } session)
        {
            return;
        }

        _selected = square;
        _targets = [.. session.LegalMovesFrom(square).Select(move => move.To)];
    }

    private PieceType? PromotionIfAny(int from, int to)
    {
        var piece = PieceAt(from);
        var lastRank = piece?.Color == Color.White ? 7 : 0;
        return piece?.Type == PieceType.Pawn && Squares.RankOf(to) == lastRank ? PieceType.Queen : null;
    }

    private async Task EngineReplyAsync()
    {
        _thinking = true;
        StateHasChanged();
        try
        {
            _engineMove = await _flow.PlayEngineMoveAsync();
            _error = null;
        }
        catch (Exception)
        {
            _error = "The computer stopped answering. Start a new game.";
        }
        finally
        {
            _thinking = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// The arrow of the computer's last move, in a coordinate system where the board is
    /// 800 by 800 and a square is 100: the line runs between the square centres, and
    /// the head sits on the destination centre pointing along the move.
    /// </summary>
    private static ((double X1, double Y1, double X2, double Y2) Line, string Head) ArrowGeometry(Move move)
    {
        var (x1, y1) = SquareCentre(move.From);
        var (x2, y2) = SquareCentre(move.To);
        var dx = x2 - x1;
        var dy = y2 - y1;
        var length = Math.Sqrt((dx * dx) + (dy * dy));
        if (length < 1)
        {
            return ((x1, y1, x2, y2), string.Empty);
        }

        // The shaft stops short of the head, and the head stops short of the square
        // centre, so the tip lands inside the destination square, not on its edge.
        var ux = dx / length;
        var uy = dy / length;
        var headLength = 34.0;
        var headWidth = 22.0;
        var tipX = x2 - (ux * 18);
        var tipY = y2 - (uy * 18);
        var shaftEndX = tipX - (ux * headLength);
        var shaftEndY = tipY - (uy * headLength);
        var leftX = shaftEndX + (-uy * (headWidth / 2));
        var leftY = shaftEndY + (ux * (headWidth / 2));
        var rightX = shaftEndX - (-uy * (headWidth / 2));
        var rightY = shaftEndY - (ux * (headWidth / 2));

        return (
            (x1, y1, shaftEndX, shaftEndY),
            FormattableString.Invariant($"{tipX:F1},{tipY:F1} {leftX:F1},{leftY:F1} {rightX:F1},{rightY:F1}"));
    }

    private static (double X, double Y) SquareCentre(int square) =>
        ((Squares.FileOf(square) * 100.0) + 50, ((7 - Squares.RankOf(square)) * 100.0) + 50);

    /// <summary>The board's box, as the browser reports it.</summary>
    private sealed record BoardBox(double Left, double Top, double Width, double Height);

    private static string PiecePath(Piece piece) => $"pieces/{PieceFiles.FileName(piece)}";

    private static string PieceAlt(Piece piece) => PieceFiles.AltText(piece);
}
