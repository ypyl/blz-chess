@page "/"
@using BlzChess.Core
@using BlzChess.Web.Engine
@inject IEngine Engine

<PageTitle>BlzChess</PageTitle>

<main class="shell">
    <header class="bar">
        <select @key="_flow.Level?.Index"
                class="level-select"
                aria-label="Opponent level"
                value="@_flow.Level.Index"
                @onchange="OnLevelChanged">
            @foreach (var level in Level.All)
            {
                <option value="@level.Index">@level.Name</option>
            }
        </select>
        <div class="actions">
            @if (_flow.Stage == GameStage.Playing)
            {
                <button type="button"
                        class="ghost"
                        disabled="@(_flow.Session.Game.Moves.Count == 0)"
                        @onclick="UndoLastMove">
                    Undo
                </button>
            }
            <button type="button" class="ghost" @onclick="HeaderAction">@HeaderActionLabel</button>
        </div>
    </header>

    <div class="board" role="grid" aria-label="Chess board">
        @for (var rank = 7; rank >= 0; rank--)
        {
            @for (var file = 0; file < 8; file++)
            {
                var square = Squares.Index(file, rank);
                <button type="button"
                        class="@SquareClass(square)"
                        aria-label="@SquareLabel(square)"
                        aria-pressed="@(_selected == square ? "true" : "false")"
                        @onclick="() => OnSquareAsync(square)">
                    @if (PieceAt(square) is { } piece)
                    {
                        @* Decorative: the button's label already names the square and
                           its piece, and a non-empty alt paints as text while the
                           SVG loads, which is the flash this change removes. *@
                        <img src="@PiecePath(piece)" alt="" aria-hidden="true" draggable="false" />
                    }
                </button>
            }
        }
    </div>

    @if (_engineMove is { } move)
    {
        var (line, head) = ArrowGeometry(move);
        <svg class="engine-arrow" viewBox="0 0 800 800" aria-hidden="true">
            <line x1="@line.X1" y1="@line.Y1" x2="@line.X2" y2="@line.Y2" />
            <polygon points="@head" />
        </svg>
    }

    <p class="status @(_flow.Stage == GameStage.Finished ? "over" : null)" title="@Status" aria-live="polite">@Status</p>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
</main>

@code {
    private GameFlow _flow = default!;
    private int _selected = Squares.None;
    private HashSet<int> _targets = [];
    private bool _thinking;
    private Move? _engineMove;
    private string? _error;

    protected override void OnInitialized() => _flow = new GameFlow(Engine);

    private string HeaderActionLabel => _flow.Stage == GameStage.Finished ? "New game" : "Restart";

    private string Status => _flow.Result.IsOver
        ? _flow.Result.Describe(Color.White)
        : _thinking ? "Thinking…" : "Your move.";

    /// <summary>
    /// Changes the opponent without touching the game. Mid-game it applies to the next
    /// move; after a result it applies to the next game.
    /// </summary>
    private void OnLevelChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var index) && _flow.ChangeLevel(Level.ByIndex(index)))
        {
            _error = null;
        }
    }

    private void UndoLastMove()
    {
        if (_flow.UndoLastMove())
        {
            ClearSelection();
            // The move the arrow described is gone with the take-back.
            _engineMove = null;
        }
    }

    private void HeaderAction()
    {
        if (_flow.Stage == GameStage.Finished)
        {
            NewGame();
            return;
        }

        if (_flow.Restart())
        {
            ClearSelection();
            _engineMove = null;
            _thinking = false;
            _error = null;
        }
    }

    private void NewGame()
    {
        _flow.NewGame();
        ClearSelection();
        _engineMove = null;
        _thinking = false;
        _error = null;
    }

    private void ClearSelection()
    {
        _selected = Squares.None;
        _targets = [];
    }

    private Piece? PieceAt(int square) => _flow.Session?.Game.Position[square];

    private string SquareClass(int square)
    {
        var classes = new List<string> { "square", Squares.IsLight(square) ? "light" : "dark" };
        if (_selected == square)
        {
            classes.Add("selected");
        }

        if (_targets.Contains(square))
        {
            classes.Add("target");
        }

        if (_thinking || _flow.Stage != GameStage.Playing)
        {
            classes.Add("locked");
        }

        return string.Join(' ', classes);
    }

    private string SquareLabel(int square)
    {
        var name = Squares.Name(square);
        return PieceAt(square) is { } piece ? $"{name}, {PieceAlt(piece)}" : $"{name}, empty";
    }

    private async Task OnSquareAsync(int square)
    {
        if (_flow.Session is not { } session || _flow.Stage != GameStage.Playing || _thinking)
        {
            return;
        }

        if (_selected != Squares.None && _targets.Contains(square))
        {
            var move = new Move(_selected, square, PromotionIfAny(_selected, square));
            if (_flow.TryPlayerMove(move, out _))
            {
                ClearSelection();
                _engineMove = null;
                await EngineReplyAsync();
                return;
            }
        }

        var legalFromSquare = PieceAt(square) is { } clicked
            && clicked.Color == session.PlayerColor
                ? session.LegalMovesFrom(square)
                : [];

        if (legalFromSquare.Count == 0)
        {
            ClearSelection();
            return;
        }

        _selected = square;
        _targets = [.. legalFromSquare.Select(move => move.To)];
    }

    private PieceType? PromotionIfAny(int from, int to)
    {
        var piece = PieceAt(from);
        var lastRank = piece?.Color == Color.White ? 7 : 0;
        return piece?.Type == PieceType.Pawn && Squares.RankOf(to) == lastRank ? PieceType.Queen : null;
    }

    private async Task EngineReplyAsync()
    {
        _thinking = true;
        StateHasChanged();
        try
        {
            _engineMove = await _flow.PlayEngineMoveAsync();
            _error = null;
        }
        catch (Exception)
        {
            _error = "The computer stopped answering. Start a new game.";
        }
        finally
        {
            _thinking = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// The arrow of the computer's last move, in a coordinate system where the board is
    /// 800 by 800 and a square is 100: the line runs between the square centres, and
    /// the head sits on the destination centre pointing along the move.
    /// </summary>
    private static ((double X1, double Y1, double X2, double Y2) Line, string Head) ArrowGeometry(Move move)
    {
        var (x1, y1) = SquareCentre(move.From);
        var (x2, y2) = SquareCentre(move.To);
        var dx = x2 - x1;
        var dy = y2 - y1;
        var length = Math.Sqrt((dx * dx) + (dy * dy));
        if (length < 1)
        {
            return ((x1, y1, x2, y2), string.Empty);
        }

        // The shaft stops short of the head, and the head stops short of the square
        // centre, so the tip lands inside the destination square, not on its edge.
        var ux = dx / length;
        var uy = dy / length;
        var headLength = 34.0;
        var headWidth = 22.0;
        var tipX = x2 - (ux * 18);
        var tipY = y2 - (uy * 18);
        var shaftEndX = tipX - (ux * headLength);
        var shaftEndY = tipY - (uy * headLength);
        var leftX = shaftEndX + (-uy * (headWidth / 2));
        var leftY = shaftEndY + (ux * (headWidth / 2));
        var rightX = shaftEndX - (-uy * (headWidth / 2));
        var rightY = shaftEndY - (ux * (headWidth / 2));

        return (
            (x1, y1, shaftEndX, shaftEndY),
            FormattableString.Invariant($"{tipX:F1},{tipY:F1} {leftX:F1},{leftY:F1} {rightX:F1},{rightY:F1}"));
    }

    private static (double X, double Y) SquareCentre(int square) =>
        ((Squares.FileOf(square) * 100.0) + 50, ((7 - Squares.RankOf(square)) * 100.0) + 50);

    private static string PiecePath(Piece piece) => $"pieces/{PieceFiles.FileName(piece)}";

    private static string PieceAlt(Piece piece) => PieceFiles.AltText(piece);
}
